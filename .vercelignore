# Explicit, so Vercel never falls back to .gitignore when deciding what to upload.
#
# The APK is excluded deliberately: at 102 MB it exceeds Vercel's per-file limit
# and fails the whole deploy. It is served from Vercel Blob instead — see the
# comment on APK.url in lib/site.ts.
node_modules
.next
.git
*.log
*.tsbuildinfo
public/*.apk
